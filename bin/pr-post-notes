#!/usr/bin/env python3

# usage: pr-post-notes [-n] [pr-number]
# Posts untracked notes.md entries from a PR worktree as one GitHub review.

import json
import os
import re
import subprocess
import sys

HEADING = re.compile(r"^## (.+):(\d+)(?:-(\d+))?$")
HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")

def command(args, cwd=None, input_text=None):
    return subprocess.run(args, cwd=cwd, input=input_text, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)

def checked(args, cwd=None):
    result = command(args, cwd)
    if result.returncode:
        output = result.stderr or result.stdout
        raise RuntimeError(output.strip() or f"{args[0]} failed")
    return result.stdout

def parse_notes(text):
    lines = text.splitlines()
    starts = [(i, match) for i, line in enumerate(lines)
              if (match := HEADING.match(line))]
    entries = []
    for pos, (start, match) in enumerate(starts):
        stop = starts[pos + 1][0] if pos + 1 < len(starts) else len(lines)
        chunk = lines[start + 1:stop]
        body_at = 0
        for i, line in enumerate(chunk):
            if line.startswith("```"):
                body_at = len(chunk)
                for j in range(i + 1, len(chunk)):
                    if re.match(r"^```\s*$", chunk[j]):
                        body_at = j + 1
                        break
                break
        body_lines = chunk[body_at:]
        while body_lines and not body_lines[0].strip():
            body_lines.pop(0)
        while body_lines and not body_lines[-1].strip():
            body_lines.pop()
        entries.append({"path": match.group(1),
                        "start": int(match.group(2)),
                        "end": int(match.group(3) or match.group(2)),
                        "body": "\n".join(body_lines)})
    return entries

def parse_diff(text):
    hunks = {}
    path = None
    for line in text.splitlines():
        if line.startswith("+++ "):
            name = line[4:]
            path = name[2:] if name.startswith("b/") else None
        elif path and (match := HUNK.match(line)):
            start = int(match.group(1))
            length = int(match.group(2) or 1)
            hunks.setdefault(path, []).append((start, start + length))
    return hunks

def relative_path(path, root):
    path = os.path.abspath(path)
    try:
        if os.path.commonpath((root, path)) != root:
            return None
    except ValueError:
        return None
    return os.path.relpath(path, root).replace(os.sep, "/")

def make_payload(entries, hunks, root, oid):
    comments = []
    fallbacks = []
    for entry in entries:
        path = relative_path(entry["path"], root)
        valid = (path is not None and entry["start"] <= entry["end"] and
                 any(entry["start"] >= first and entry["end"] < last
                     for first, last in hunks.get(path, [])))
        if not valid:
            fallbacks.append((path or entry["path"], entry))
            continue
        comment = {"path": path, "line": entry["end"], "side": "RIGHT",
                   "body": entry["body"]}
        if entry["start"] < entry["end"]:
            comment.update(start_line=entry["start"], start_side="RIGHT")
        comments.append(comment)
    body = ""
    if fallbacks:
        parts = ["Some notes could not be attached to diff lines:"]
        for path, entry in fallbacks:
            location = str(entry["start"])
            if entry["end"] != entry["start"]:
                location += f"-{entry['end']}"
            parts.extend((f"`{path}:{location}`", entry["body"]))
        body = "\n\n".join(parts)
    return {"commit_id": oid, "event": "COMMENT", "comments": comments,
            "body": body}

def find_notes(root):
    found = []
    for directory, dirs, files in os.walk(root):
        dirs[:] = [name for name in dirs if name != ".git"]
        if "notes.md" not in files:
            continue
        path = os.path.join(directory, "notes.md")
        rel = os.path.relpath(path, root)
        tracked = command(["git", "ls-files", "--error-unmatch", "--", rel], root)
        if tracked.returncode:
            found.append(path)
    return sorted(found)

def usage():
    print("usage: pr-post-notes [-n] [pr-number]", file=sys.stderr)
    return 1

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    dry_run = False
    if argv and argv[0] == "-n":
        dry_run = True
        argv.pop(0)
    if len(argv) > 1 or (argv and not argv[0].isdigit()):
        return usage()
    try:
        root = checked(["git", "rev-parse", "--show-toplevel"]).strip()
        match = re.search(r"-pr-(\d+)$", os.path.basename(root))
        number = argv[0] if argv else (match.group(1) if match else None)
        if not number:
            result = command(["gh", "pr", "view", "--json", "number", "-q", ".number"], root)
            if result.returncode or not result.stdout.strip().isdigit():
                return usage()
            number = result.stdout.strip()
        meta = json.loads(checked(["gh", "pr", "view", number, "--json",
                                   "headRefOid,number"], root))
        number = str(meta["number"])
        oid = meta["headRefOid"]
        head = checked(["git", "rev-parse", "HEAD"], root).strip()
        if head != oid:
            message = (f"HEAD does not match PR #{number}; refresh with "
                       f"git-worktree-pr {number}")
            if not dry_run:
                print(message, file=sys.stderr)
                return 1
            print(f"warning: {message}", file=sys.stderr)
        note_files = find_notes(root)
        entries = []
        for path in note_files:
            with open(path, encoding="utf-8") as source:
                parsed = parse_notes(source.read())
            for entry in parsed:
                if not entry["body"]:
                    print(f"warning: skipping empty note {entry['path']}:{entry['start']}",
                          file=sys.stderr)
                else:
                    entry["file"] = path
                    entries.append(entry)
        consumed = sorted({entry["file"] for entry in entries})
        diff = checked(["gh", "pr", "diff", number], root) if entries else ""
        payload = make_payload(entries, parse_diff(diff), root, oid)
        if not payload["comments"] and not payload["body"]:
            print("no notes to post")
            return 0
        if dry_run:
            print(json.dumps(payload, indent=2))
            print("notes files that would be consumed:")
            for path in consumed:
                print(path)
            return 0
        result = command(["gh", "api", f"repos/{{owner}}/{{repo}}/pulls/{number}/reviews",
                          "--method", "POST", "--input", "-"], root,
                         json.dumps(payload))
        if result.returncode:
            output = "\n".join(part.rstrip() for part in
                               (result.stdout, result.stderr) if part.rstrip())
            print(output, file=sys.stderr)
            return 1
        response = json.loads(result.stdout)
        print(response["html_url"])
        for path in consumed:
            posted = os.path.join(os.path.dirname(path), "notes.posted.md")
            with open(path, "rb") as source, open(posted, "ab") as target:
                target.write(source.read())
            os.unlink(path)
        return 0
    except (OSError, RuntimeError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"pr-post-notes: {error}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
