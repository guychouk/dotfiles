#!/bin/sh

PID_FILE="$HOME/.caffeinate.pid"

if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE")
  if kill "$PID" 2>/dev/null; then
    # Caffeinate is running, kill it
    rm "$PID_FILE"
    osascript -e 'display notification "🔴" with title "Caffeinate"'
    exit 0
  fi
  # PID file stale, clean up and fall through to start it
  rm "$PID_FILE"
fi

caffeinate -sdi &
echo $! > "$PID_FILE"
osascript -e 'display notification "🟢" with title "Caffeinate"'
