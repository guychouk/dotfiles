d=json.load(sys.stdin)
t=[x for x in d['targets'] if x['name']=='$NAME']
print('running' if t and t[0].get('running') else 'stopped')
")
if [ "$STATUS" = "running" ]; then
    /Users/guychouk/.local/bin/paddock stop "$NAME"
else
    /Users/guychouk/.local/bin/paddock start "$NAME"
fi
