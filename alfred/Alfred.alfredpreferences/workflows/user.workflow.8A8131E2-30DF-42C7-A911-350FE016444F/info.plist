import json, sys
data = json.load(sys.stdin)
items = []
for t in data['targets']:
    if t['kind'] != 'agent':
        continue
    running = t.get('running', False)
    icon = '●' if running else '○'
    label = 'Running' if running else 'Stopped'
    items.append({
        'uid': t['name'],
        'title': t['name'],
        'subtitle': icon + ' ' + label + '  |  cmd: attach abduco session in kitty',
        'arg': t['name'],
        'mods': {
            'cmd': {
                'subtitle': 'Open kitty window and attach to abduco session',
                'arg': t['name'],
                'valid': True
            }
        }
    })
print(json.dumps({'items': items}))
"
