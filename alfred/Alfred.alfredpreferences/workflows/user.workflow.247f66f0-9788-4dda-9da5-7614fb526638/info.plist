				<key>script</key>
				<string>PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"
REPO="{query}"
REPONAME=$(basename "$REPO")
osascript -e "display notification \"Pushing $REPONAME...\" with title \"Git Push\""
cd "$REPO" || exit 1
if git push &gt;/tmp/git_push.log 2&gt;&amp;1; then
  osascript -e "display notification \"Push complete\" with title \"$REPONAME\" subtitle \"Success\""
else
  osascript -e "display notification \"Push failed — see /tmp/git_push.log\" with title \"$REPONAME\" subtitle \"Error\""
fi</string>
