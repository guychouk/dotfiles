				<key>script</key>
				<string>FISH=/opt/homebrew/bin/fish
KITTY=/Applications/kitty.app/Contents/MacOS/kitty

SCRIPT=$(cat &lt;&lt;'FISH_EOF'
set profiles factify-dev factify-prod factify-staging factify-sandbox factify-root identity-terraform
for profile in $profiles
    echo "==> aws sso login --profile $profile"
    /usr/local/bin/aws sso login --profile $profile
end
echo ""
echo "All profiles done."
read -P "Press Enter to close... " _
FISH_EOF
)

"$KITTY" --single-instance -- "$FISH" -c "$SCRIPT"
</string>
