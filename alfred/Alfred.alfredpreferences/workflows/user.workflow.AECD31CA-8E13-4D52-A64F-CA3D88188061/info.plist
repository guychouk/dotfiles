				<string>PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"
abduco -l 2&gt;/dev/null | tail -n +2 | python3 -c '
import sys, json
items = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line.strip():
        continue
    parts = line.split("\t")
    if len(parts) &lt; 3:
        continue
    attached = line.startswith("*")
    ts = parts[1].strip()
    name = parts[-1].strip()
    subtitle = ("attached now" if attached else "detached") + " - last active " + ts
    items.append({"uid": name, "title": name, "subtitle": subtitle, "arg": name})
if not items:
    items.append({"title": "No abduco sessions running", "subtitle": "abduco -l returned nothing to attach to", "valid": False})
print(json.dumps({"items": items}))
'</string>
