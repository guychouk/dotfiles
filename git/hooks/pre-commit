#!/bin/sh
# Markdown formatting gate. Runs only when the repo being committed to opts in
# via a .prettierrc at its root, so this global hook (wired through
# core.hooksPath) doesn't surprise every other repo on the machine.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

check_markdown() {
  prettierrc=""
  for name in .prettierrc .prettierrc.json .prettierrc.yaml .prettierrc.yml .prettierrc.js; do
    if [ -f "$repo_root/$name" ]; then
      prettierrc="$repo_root/$name"
      break
    fi
  done
  [ -n "$prettierrc" ] || return 0

  staged_md=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')
  [ -n "$staged_md" ] || return 0

  if ! command -v npx >/dev/null 2>&1; then
    echo "pre-commit: npx not found, skipping markdown format check" >&2
    return 0
  fi

  if ! printf '%s\n' "$staged_md" | xargs npx --yes prettier@3 --check; then
    echo "pre-commit: markdown formatting check failed. run:" >&2
    echo "  npx prettier@3 --write $(printf '%s' "$staged_md" | tr '\n' ' ')" >&2
    return 1
  fi
}

# Theme drift gate. Opt-in by presence: any immediate subdirectory holding a
# targets file and either a sibling palette or a palette line in targets must
# have theme outputs matching the palette. Skipped silently when paleta is not
# on PATH.
check_themes() {
  command -v paleta >/dev/null 2>&1 || return 0

  for d in "$repo_root"/*/; do
    [ -d "$d" ] || continue
    [ -f "$d/targets" ] || continue

    palette=""
    for f in "$d"/*.palette; do
      [ -f "$f" ] && { palette="$f"; break; }
    done
    if [ -z "$palette" ] && ! grep -q '^palette ' "$d/targets"; then
      continue
    fi

    paleta check "$d"
    status=$?
    if [ "$status" -ne 0 ]; then
      if [ "$status" -eq 1 ]; then
        echo "pre-commit: ${d%/} theme outputs drifted from palette. run: paleta build ${d%/}" >&2
      fi
      return 1
    fi
  done
}

failed=0
check_markdown || failed=1
check_themes || failed=1
exit "$failed"
